---
import { Play, ShieldCheck, Zap, Star, CheckCircle, Flame, ArrowRight, Tv, Radio, Sparkles } from "lucide-astro";
import { CURRENT_YEAR } from "../utils/date";

interface Props {
  h1Title?: string;
  subtitle?: string;
  badgeText?: string;
  city?: string;
  primaryKeyword?: string;
}

const {
  h1Title = "IPTV Sverige — Streama Svensk TV & Sport i Kristallklar 4K & 8K",
  subtitle = "Upptäck Sveriges mest stabila IPTV-tjänst med 99.9% drifttid. Njut av direktsänd sport, direktsänd sport, film och alla svenska favoriter utan buffring eller bindningstid.",
  badgeText = `🇸🇪 Sveriges #1 IPTV-Tjänst ${CURRENT_YEAR}`,
  city,
  primaryKeyword = "IPTV Sverige"
} = Astro.props;
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden" aria-labelledby="hero-heading">
  <!-- Background Glow & Mesh Elements -->
  <div class="absolute inset-0 pointer-events-none z-0">
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[450px] bg-gradient-to-tr from-emerald-500/15 via-emerald-600/10 to-amber-500/10 rounded-full blur-[120px] -z-10"></div>
    <div class="absolute top-1/2 -left-20 w-80 h-80 bg-emerald-700/10 rounded-full blur-[100px] -z-10"></div>
    <div class="absolute bottom-10 -right-20 w-80 h-80 bg-amber-500/10 rounded-full blur-[100px] -z-10"></div>
  </div>

  <div class="max-container relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & Conversion Elements -->
      <div class="lg:col-span-7 text-center lg:text-left space-y-6">
        
        <!-- Live Verified Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full glass-card border-emerald-500/30 text-emerald-300 text-xs sm:text-sm font-semibold shadow-inner">
          <span class="flex h-2 w-2 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span>{badgeText}</span>
          {city && <span class="bg-emerald-500/20 text-emerald-300 px-2 py-0.5 rounded-full text-xs font-bold border border-emerald-500/30">📍 {city}</span>}
        </div>

        <!-- Strict Single H1 Tag -->
        <h1 id="hero-heading" class="text-3xl sm:text-4xl md:text-5xl xl:text-6xl font-extrabold tracking-tight text-white font-display leading-[1.12]">
          {city ? (
            <>
              IPTV i {city} — <span class="text-gradient-emerald">Sveriges Bästa IPTV</span> för Sport & Underhållning
            </>
          ) : (
            <>
              {h1Title.split("—")[0]} — <span class="text-gradient-emerald">{h1Title.split("—")[1] || "Kristallklar 4K & 8K Streaming"}</span>
            </>
          )}
        </h1>

        <!-- Opening Paragraph with Primary Keyword within first 75-100 words -->
        <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
          När du väljer <strong>{primaryKeyword}</strong> får du tillgång till Nordens ledande nätverk för direktsänd underhållning, svensk sport och internationell film i 4K UHD. Vi erbjuder blixtsnabb aktivering på 5 minuter, full kompatibilitet med alla Smart TV-enheter och appar samt 99.9% garanterad upptid med dedikerade servrar i Stockholm.
        </p>

        <!-- Trust Badges Checklist -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-2 max-w-xl mx-auto lg:mx-0 text-left">
          <div class="flex items-center gap-2 text-xs sm:text-sm text-slate-200">
            <CheckCircle class="w-4 h-4 text-emerald-400 shrink-0" />
            <span>Direktsänd Sport & Matcher i 60 FPS</span>
          </div>
          <div class="flex items-center gap-2 text-xs sm:text-sm text-slate-200">
            <CheckCircle class="w-4 h-4 text-emerald-400 shrink-0" />
            <span>Anti-Freeze 9.0 Teknologi</span>
          </div>
          <div class="flex items-center gap-2 text-xs sm:text-sm text-slate-200">
            <CheckCircle class="w-4 h-4 text-emerald-400 shrink-0" />
            <span>Svensk EPG & Programtablå</span>
          </div>
          <div class="flex items-center gap-2 text-xs sm:text-sm text-slate-200">
            <CheckCircle class="w-4 h-4 text-emerald-400 shrink-0" />
            <span>Betala tryggt med Swish</span>
          </div>
          <div class="flex items-center gap-2 text-xs sm:text-sm text-slate-200">
            <CheckCircle class="w-4 h-4 text-emerald-400 shrink-0" />
            <span>Ingen bindningstid</span>
          </div>
          <div class="flex items-center gap-2 text-xs sm:text-sm text-slate-200">
            <CheckCircle class="w-4 h-4 text-emerald-400 shrink-0" />
            <span>Support 24/7 på svenska</span>
          </div>
        </div>

        <!-- High-Converting CTA Area -->
        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <a 
            href="/#pricing" 
            class="btn-primary w-full sm:w-auto text-base py-4 px-8 shadow-xl shadow-emerald-500/30 group"
            aria-label="Köp abonnemang nu"
          >
            <span>Skaffa IPTV Nu — Från 50 kr/mån</span>
            <ArrowRight class="w-5 h-5 group-hover:translate-x-1 transition-transform" />
          </a>

          <a 
            href="https://wa.me/18036582620?text=Hej!%20Jag%20vill%20testa%20IPTV%20Sverige%20gratis%20i%2024%20timmar." 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-6 py-4 rounded-full font-bold text-sm text-slate-200 bg-white/5 hover:bg-white/10 border border-emerald-500/40 hover:border-emerald-400 transition-all flex items-center justify-center gap-2 shadow-lg"
            aria-label="Testa IPTV Sverige gratis i 24 timmar"
          >
            <Zap class="w-4 h-4 text-amber-400" />
            <span>Testa Gratis i 24 Timmar</span>
          </a>
        </div>

        <!-- Social Proof Metric Row -->
        <div class="pt-4 flex items-center justify-center lg:justify-start gap-6 text-xs text-slate-400">
          <div class="flex items-center gap-1.5">
            <div class="flex text-amber-400">
              {[...Array(5)].map(() => (
                <Star class="w-4 h-4 fill-amber-400 text-amber-400" />
              ))}
            </div>
            <span class="font-bold text-slate-200 text-sm">4.9/5</span>
          </div>
          <span class="text-slate-600">|</span>
          <span class="text-slate-300">Över <strong>15 000+ aktiva användare</strong> i Sverige</span>
        </div>

      </div>

      <!-- Right Column: Interactive TV / Streaming UI Mockup -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          
          <!-- Outer Ambient Glow -->
          <div class="absolute -inset-1 bg-gradient-to-r from-emerald-500 via-teal-500 to-amber-500 rounded-3xl blur-xl opacity-30 group-hover:opacity-100 transition duration-1000"></div>

          <!-- Modern Glass TV Player Mockup -->
          <div class="relative rounded-2xl glass-card-glow overflow-hidden border border-emerald-500/30 bg-slate-950/90 shadow-2xl p-4 sm:p-6 space-y-4">
            
            <!-- Mockup Header -->
            <div class="flex items-center justify-between border-b border-white/10 pb-3">
              <div class="flex items-center gap-2">
                <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
                <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
                <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
                <span class="text-xs font-mono text-slate-400 ml-2">IPTV-Sverige Player 4K v9.0</span>
              </div>
              <div class="flex items-center gap-1 bg-emerald-500/20 text-emerald-400 px-2 py-0.5 rounded text-[10px] font-mono font-bold">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                LIVE 60FPS
              </div>
            </div>

            <!-- Hero Image Display with Primary Keyword Alt Text -->
  <div class="mb-4">
    <img 
      src="/images/iptv-sverige-hero.svg" 
      alt="IPTV Sverige — Streama Svensk TV och Direktsänd Sport i 4K UHD på Smart TV" 
      class="w-full h-auto rounded-xl shadow-inner border border-white/10" 
      loading="eager"
      width="784"
      height="434"
    />
  </div>
  <!-- Video Player Preview Area -->
            <div class="relative h-48 sm:h-56 rounded-xl bg-gradient-to-br from-slate-900 via-emerald-950/40 to-slate-900 overflow-hidden border border-white/10 flex flex-col justify-between p-4">
              
              <!-- Stream Overlays -->
              <div class="flex justify-between items-start">
                <div class="bg-black/60 backdrop-blur-md px-2.5 py-1 rounded-lg text-xs font-bold text-white border border-white/10 flex items-center gap-1.5">
                  <Radio class="w-3.5 h-3.5 text-emerald-400 animate-pulse" />
                  <span>Svenska Kanaler HD & 4K</span>
                </div>
                <span class="bg-emerald-600 text-white text-[10px] font-black uppercase px-2 py-0.5 rounded shadow">
                  4K ULTRA HD
                </span>
              </div>

              <!-- Center Play Action -->
              <div class="text-center space-y-2">
                <div class="inline-flex w-14 h-14 rounded-full bg-emerald-500/90 text-slate-950 items-center justify-center shadow-lg shadow-emerald-500/50 hover:scale-110 transition-transform cursor-pointer">
                  <Play class="w-7 h-7 fill-slate-950 ml-1" />
                </div>
                <p class="text-xs font-semibold text-slate-200">Direktsänd Sport & Matcher</p>
              </div>

              <!-- Stream Info Bar -->
              <div class="flex justify-between items-center text-[11px] text-slate-400 bg-black/50 backdrop-blur-sm px-3 py-1.5 rounded-lg border border-white/5">
                <span>Bitrate: 24.5 Mbps</span>
                <span class="text-emerald-400 font-bold">Buffert: 0.0s (Anti-Freeze)</span>
                <span>Ljud: Dolby 5.1</span>
              </div>
            </div>

            <!-- Channel Quick Tabs / Categories -->
            <div class="grid grid-cols-3 gap-2 text-center text-xs">
              <div class="p-2.5 rounded-xl bg-white/5 border border-white/10 hover:border-emerald-500/40 transition-colors">
                <div class="font-bold text-white">🇸🇪 Svensk TV</div>
                <div class="text-[10px] text-slate-400">Svenska Favoritkanaler</div>
              </div>
              <div class="p-2.5 rounded-xl bg-emerald-500/10 border border-emerald-500/30">
                <div class="font-bold text-emerald-300">⚽ Live Sport</div>
                <div class="text-[10px] text-slate-400">Live Sport i 60 FPS</div>
              </div>
              <div class="p-2.5 rounded-xl bg-white/5 border border-white/10 hover:border-emerald-500/40 transition-colors">
                <div class="font-bold text-white">🎬 Film & Serier</div>
                <div class="text-[10px] text-slate-400">Svensktextat i 4K</div>
              </div>
            </div>

            <!-- Trust Badge Box -->
            <div class="pt-2 flex items-center justify-between text-xs text-slate-400 border-t border-white/5">
              <span class="flex items-center gap-1.5 text-emerald-400 font-semibold">
                <ShieldCheck class="w-4 h-4" /> 100% Trygg leverans
              </span>
              <span class="text-slate-300 font-mono text-[11px]">Server: SE-Stockholm-01</span>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>

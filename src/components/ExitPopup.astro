---
import { Gift, X, Zap, ShieldCheck, ArrowRight, MessageCircle } from "lucide-astro";
---

<!-- Exit Intent Modal -->
<div 
  id="exit-popup" 
  class="fixed inset-0 z-[100] hidden items-center justify-center p-4 bg-black/80 backdrop-blur-md transition-opacity duration-300 opacity-0"
  role="dialog"
  aria-modal="true"
  aria-labelledby="exit-popup-title"
>
  <div 
    class="relative w-full max-w-lg rounded-3xl p-8 glass-card-glow border-2 border-emerald-500/50 bg-gradient-to-b from-slate-900 via-emerald-950/60 to-slate-950 shadow-2xl shadow-emerald-500/25 text-center space-y-6 transform scale-95 transition-transform duration-300"
    id="exit-popup-modal"
  >
    <!-- Close Button -->
    <button 
      id="close-exit-popup" 
      type="button" 
      class="absolute top-4 right-4 p-2 rounded-full bg-white/10 hover:bg-white/20 text-slate-300 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-emerald-400"
      aria-label="Stäng erbjudande"
    >
      <X class="w-5 h-5" />
    </button>

    <!-- Header Icon -->
    <div class="inline-flex w-16 h-16 rounded-2xl bg-gradient-to-br from-emerald-400 to-emerald-600 items-center justify-center text-slate-950 shadow-xl shadow-emerald-500/40 animate-bounce">
      <Gift class="w-8 h-8 stroke-[2.5]" />
    </div>

    <!-- Main Headings -->
    <div class="space-y-2">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-amber-500 text-slate-950">
        🇸🇪 EXKLUSIVT ERBJUDANDE JUST NU
      </span>
      
      <h3 id="exit-popup-title" class="text-2xl sm:text-3xl font-black text-white font-display tracking-tight leading-tight">
        Vänta! Teckna Nu & Få <br/><span class="text-gradient-emerald">1 Månad Extra Gratis!</span>
      </h3>
      
      <p class="text-xs sm:text-sm text-slate-300 leading-relaxed max-w-sm mx-auto">
        Lämna inte sidan tomhänt. Beställ valfritt abonnemang via WhatsApp just nu så lägger vi automatiskt till <strong>1 månad gratis</strong> på ditt konto.
      </p>
    </div>

    <!-- Value Bullet Points -->
    <div class="bg-white/5 rounded-2xl p-4 border border-white/10 text-xs text-slate-200 text-left space-y-2">
      <div class="flex items-center gap-2">
        <Zap class="w-4 h-4 text-amber-400 shrink-0" />
        <span>Gäller vid beställning av 6 eller 12 månaders paket</span>
      </div>
      <div class="flex items-center gap-2">
        <ShieldCheck class="w-4 h-4 text-emerald-400 shrink-0" />
        <span>24 timmars full återbetalningsgaranti ingår</span>
      </div>
    </div>

    <!-- Direct Action Button -->
    <div class="space-y-3 pt-2">
      <a 
        id="exit-whatsapp-cta"
        href="https://wa.me/18036582620?text=Hej!%20Jag%20vill%20utnyttja%20erbjudandet:%20Teckna%20nu%20och%20få%201%20månad%20extra%20gratis!"
        target="_blank" 
        rel="noopener noreferrer"
        class="btn-primary w-full py-4 px-6 text-sm sm:text-base font-extrabold shadow-xl shadow-emerald-500/40 flex items-center justify-center gap-2 group"
      >
        <MessageCircle class="w-5 h-5 text-slate-950" />
        <span>Hämta Min Gratis Månad på WhatsApp</span>
        <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
      </a>

      <button 
        id="dismiss-exit-popup" 
        type="button" 
        class="text-xs text-slate-400 hover:text-slate-200 underline decoration-slate-600 transition-colors"
      >
        Nej tack, jag avstår 1 månad gratis streaming
      </button>
    </div>

  </div>
</div>

<script>
  let popupShown = false;
  const exitPopup = document.getElementById("exit-popup");
  const modal = document.getElementById("exit-popup-modal");
  const closeBtn = document.getElementById("close-exit-popup");
  const dismissBtn = document.getElementById("dismiss-exit-popup");

  function showExitPopup() {
    if (popupShown || sessionStorage.getItem("exit_popup_dismissed") === "true") return;
    popupShown = true;
    if (exitPopup && modal) {
      exitPopup.classList.remove("hidden");
      exitPopup.classList.add("flex");
      setTimeout(() => {
        exitPopup.classList.remove("opacity-0");
        exitPopup.classList.add("opacity-100");
        modal.classList.remove("scale-95");
        modal.classList.add("scale-100");
      }, 20);
    }
  }

  function hideExitPopup() {
    if (exitPopup && modal) {
      exitPopup.classList.add("opacity-0");
      exitPopup.classList.remove("opacity-100");
      modal.classList.add("scale-95");
      modal.classList.remove("scale-100");
      setTimeout(() => {
        exitPopup.classList.add("hidden");
        exitPopup.classList.remove("flex");
      }, 300);
      sessionStorage.setItem("exit_popup_dismissed", "true");
    }
  }

  // Mouse leave viewport towards top
  document.addEventListener("mouseleave", (e) => {
    if (e.clientY <= 15) {
      showExitPopup();
    }
  });

  // Mobile fallback after 45s
  setTimeout(() => {
    if (window.innerWidth < 768) {
      showExitPopup();
    }
  }, 45000);

  if (closeBtn) closeBtn.addEventListener("click", hideExitPopup);
  if (dismissBtn) dismissBtn.addEventListener("click", hideExitPopup);
  
  if (exitPopup) {
    exitPopup.addEventListener("click", (e) => {
      if (e.target === exitPopup) hideExitPopup();
    });
  }

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") hideExitPopup();
  });
</script>

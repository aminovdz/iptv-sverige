---
import { ArrowRight, MessageCircle, Zap, ShieldCheck, CheckCircle2 } from "lucide-astro";

interface Props {
  title?: string;
  subtitle?: string;
  primaryBtnText?: string;
  primaryBtnHref?: string;
  secondaryBtnText?: string;
  secondaryBtnHref?: string;
}

const {
  title = "Redo Att Uppgradera Till Sveriges Mest Stabila IPTV-Tjänst?",
  subtitle = "Bli en del av över 15 000 nöjda svenskar som njuter av kristallklar 4K-streaming, direktsänd sport och alla favoritkanaler utan buffring. Snabb aktivering på under 5 minuter.",
  primaryBtnText = "Se Våra Abonnemang & Priser",
  primaryBtnHref = "/#pricing",
  secondaryBtnText = "Chatta på WhatsApp (Direkt Svar)",
  secondaryBtnHref = "https://wa.me/18036582620?text=Hej!%20Jag%20vill%20ha%20hjälp%20att%20komma%20igång%20med%20IPTV%20Sverige."
} = Astro.props;
---

<section class="py-16 md:py-24 relative overflow-hidden" aria-labelledby="cta-heading">
  <div class="max-container">
    <div class="relative rounded-3xl overflow-hidden glass-card-glow border border-emerald-500/40 p-8 sm:p-12 md:p-16 text-center bg-gradient-to-b from-slate-900/90 via-emerald-950/30 to-slate-950/90 shadow-2xl">
      
      <!-- Ambient Glow Behind Box -->
      <div class="absolute -top-32 -left-32 w-80 h-80 bg-emerald-500/20 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-32 -right-32 w-80 h-80 bg-amber-500/15 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 max-w-3xl mx-auto space-y-6">
        
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-xs font-bold uppercase tracking-wider">
          <Zap class="w-3.5 h-3.5 text-amber-400" />
          <span>Blixtsnabb Aktivering Inom 5 Minuter</span>
        </div>

        <!-- H2 Heading -->
        <h2 id="cta-heading" class="text-3xl sm:text-4xl md:text-5xl font-black text-white font-display tracking-tight leading-tight">
          {title}
        </h2>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
          {subtitle}
        </p>

        <!-- CTA Buttons Row -->
        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a 
            href={primaryBtnHref} 
            class="btn-primary w-full sm:w-auto text-base py-4 px-8 shadow-xl shadow-emerald-500/30 group"
            aria-label="Gå till prislistan och välj paket"
          >
            <span>{primaryBtnText}</span>
            <ArrowRight class="w-5 h-5 group-hover:translate-x-1 transition-transform" />
          </a>

          <a 
            href={secondaryBtnHref} 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-6 py-4 rounded-full font-bold text-sm text-slate-100 bg-white/5 hover:bg-white/10 border border-emerald-500/40 hover:border-emerald-400 transition-all flex items-center justify-center gap-2 shadow-lg"
            aria-label="Kontakta support på WhatsApp"
          >
            <MessageCircle class="w-4 h-4 text-emerald-400" />
            <span>{secondaryBtnText}</span>
          </a>
        </div>

        <!-- Trust Badges Under CTA -->
        <div class="pt-6 border-t border-white/10 grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs text-slate-300 max-w-2xl mx-auto">
          <div class="flex items-center justify-center gap-1.5">
            <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0" />
            <span>24h Öppet Köp</span>
          </div>
          <div class="flex items-center justify-center gap-1.5">
            <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0" />
            <span>Ingen Bindningstid</span>
          </div>
          <div class="flex items-center justify-center gap-1.5">
            <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0" />
            <span>Swish & Klarna</span>
          </div>
          <div class="flex items-center justify-center gap-1.5">
            <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0" />
            <span>Direktleverans</span>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

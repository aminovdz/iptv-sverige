---
import { MapPin, Wifi, ShieldCheck, Sparkles, ArrowRight } from "lucide-astro";

interface CityItem {
  name: string;
  slug: string;
  region: string;
  population: string;
  ping: string;
}

const cities: CityItem[] = [
  { name: "Stockholm", slug: "stockholm", region: "Stockholms län", population: "980 000+", ping: "4ms (Huvudnod)" },
  { name: "Göteborg", slug: "goteborg", region: "Västra Götalands län", population: "600 000+", ping: "6ms (Västkustnod)" },
  { name: "Malmö", slug: "malmo", region: "Skåne län", population: "360 000+", ping: "8ms (Sydnod)" },
  { name: "Uppsala", slug: "uppsala", region: "Uppsala län", population: "240 000+", ping: "5ms" },
  { name: "Västerås", slug: "vasteras", region: "Västmanlands län", population: "155 000+", ping: "6ms" },
  { name: "Örebro", slug: "orebro", region: "Örebro län", population: "156 000+", ping: "7ms" },
  { name: "Linköping", slug: "linkoping", region: "Östergötlands län", population: "165 000+", ping: "7ms" },
  { name: "Helsingborg", slug: "helsingborg", region: "Skåne län", population: "150 000+", ping: "8ms" },
  { name: "Jönköping", slug: "jonkoping", region: "Jönköpings län", population: "145 000+", ping: "8ms" },
  { name: "Norrköping", slug: "norrkoping", region: "Östergötlands län", population: "144 000+", ping: "7ms" },
  { name: "Lund", slug: "lund", region: "Skåne län", population: "128 000+", ping: "8ms" },
  { name: "Umeå", slug: "umea", region: "Västerbottens län", population: "132 000+", ping: "12ms (Norrlandsnod)" },
  { name: "Gävle", slug: "gavle", region: "Gävleborgs län", population: "103 000+", ping: "8ms" },
  { name: "Borås", slug: "boras", region: "Västra Götalands län", population: "114 000+", ping: "7ms" },
  { name: "Södertälje", slug: "sodertalje", region: "Stockholms län", population: "102 000+", ping: "5ms" },
  { name: "Eskilstuna", slug: "eskilstuna", region: "Södermanlands län", population: "107 000+", ping: "6ms" }
];
---

<section id="cities" class="py-20 relative overflow-hidden" aria-labelledby="cities-heading">
  <div class="max-container">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-bold uppercase tracking-wider">
        <MapPin class="w-3.5 h-3.5" />
        <span>Lokal Täckning & Servrar</span>
      </div>
      <h2 id="cities-heading" class="text-3xl sm:text-4xl md:text-5xl font-black text-white font-display tracking-tight">
        Sveriges Snabbaste <span class="text-gradient-emerald">IPTV i Din Stad</span>
      </h2>
      <p class="text-base sm:text-lg text-slate-300">
        Med lokalt optimerade servrar och CDN-nätverk i Sverige garanterar vi minimal svarstid (under 10ms), blixtsnabb kanalväxling och noll buffring från norr till söder.
      </p>
    </div>

    <!-- Cities Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
      {cities.map((city) => (
        <a 
          href={`/locations/${city.slug}`}
          class="group rounded-2xl p-5 glass-card border border-white/5 hover:border-emerald-500/40 hover:bg-white/[0.04] transition-all duration-200 flex flex-col justify-between"
          title={`IPTV ${city.name} — Boka abonnemang och streama i ${city.name}`}
        >
          <div>
            <div class="flex items-center justify-between mb-2">
              <div class="flex items-center gap-2">
                <MapPin class="w-4 h-4 text-emerald-400 group-hover:scale-110 transition-transform" />
                <h3 class="font-bold text-white group-hover:text-emerald-300 transition-colors text-base">
                  IPTV {city.name}
                </h3>
              </div>
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            </div>
            <p class="text-xs text-slate-400 mb-3">{city.region}</p>
          </div>

          <div class="pt-3 border-t border-white/5 flex items-center justify-between text-[11px] text-slate-400">
            <span class="text-emerald-400 font-mono font-medium flex items-center gap-1">
              <Wifi class="w-3 h-3" /> {city.ping}
            </span>
            <span class="flex items-center gap-0.5 text-slate-300 group-hover:text-emerald-400 transition-colors">
              <span>Utforska</span>
              <ArrowRight class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" />
            </span>
          </div>
        </a>
      ))}
    </div>

    <!-- Bottom Regional Guarantee Note -->
    <div class="mt-12 p-6 rounded-2xl glass-card border border-emerald-500/20 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-emerald-500/10 flex items-center justify-center text-emerald-400 shrink-0">
          <ShieldCheck class="w-5 h-5" />
        </div>
        <div>
          <h3 class="text-sm font-bold text-white">Bor du på en annan ort eller landsbygd?</h3>
          <p class="text-xs text-slate-400 mt-0.5">Vår streaming fungerar överallt i Sverige via alla internetleverantörer (Telia, Tele2, Telenor, Bahnhof, Tre etc.).</p>
        </div>
      </div>
      <a 
        href="/#pricing" 
        class="px-5 py-2.5 rounded-full text-xs font-bold bg-white/10 hover:bg-emerald-500 hover:text-slate-950 text-white transition-all shrink-0"
      >
        Kom Igång Nu
      </a>
    </div>

  </div>
</section>

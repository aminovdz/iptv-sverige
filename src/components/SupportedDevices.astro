---
import { Tv, Monitor, Smartphone, Cast, HardDrive, Cpu, CheckCircle, Sparkles, ExternalLink } from "lucide-astro";

const deviceCategories = [
  {
    title: "Smart TV",
    icon: Tv,
    badge: "Mest Populärt",
    description: "Installera en IPTV-app direkt från TV:ns appbutik utan extra boxar.",
    devices: ["Samsung Smart TV (Tizen OS)", "LG Smart TV (webOS)", "Sony Bravia (Android TV)", "Philips Smart TV", "TCL & Hisense"]
  },
  {
    title: "Streaming-enheter & Mediaspelare",
    icon: Cast,
    badge: "4K 60FPS",
    description: "Blixtsnabb prestanda och smidig navigering med extern mediaspelare.",
    devices: ["Apple TV 4K & HD", "Google Chromecast med Google TV", "Amazon Fire TV Stick 4K", "Nvidia Shield Pro", "Xiaomi Mi Box S"]
  },
  {
    title: "Mobiltelefoner & Surfplattor",
    icon: Smartphone,
    badge: "Ta Med På Resan",
    description: "Streama var du än är i Sverige eller utomlands via 4G/5G eller Wi-Fi.",
    devices: ["iPhone (iOS)", "iPad (iPadOS)", "Android telefoner (Samsung, Xiaomi)", "Android surfplattor", "Huawei HarmonyOS"]
  },
  {
    title: "Datorer & Webbläsare",
    icon: Monitor,
    badge: "Web & App",
    description: "Kolla direkt via webbläsaren eller dedikerade program för datorn.",
    devices: ["Windows 10 & 11 (VLC / IPTV Player)", "Mac macOS (Apple Silicon & Intel)", "Linux (Ubuntu / Debian)", "Web Player (Ingen nedladdning krävs)"]
  },
  {
    title: "IPTV Hårdvaruboxar",
    icon: HardDrive,
    badge: "Dedikerad Box",
    description: "Perfekt för dig som vill ha traditionell fjärrkontroll och extrem hastighet.",
    devices: ["Formuler Z11 Pro Max / Z10", "MAG Boxar (MAG 520, 524, 420)", "Dreamlink Boxar", "Openbox & Octagon"]
  },
  {
    title: "Rekommenderade Appar",
    icon: Cpu,
    badge: "Topp Betyg",
    description: "Vi stödjer alla marknadens ledande IPTV-appar med Xtream Codes och M3U.",
    devices: ["TiviMate IPTV Player (Rekommenderas för Android/TV)", "IPTV Smarters Pro", "XCIPTV Player", "GSE Smart IPTV", "OTT Navigator IPTV"]
  }
];
---

<section id="devices" class="py-20 relative overflow-hidden" aria-labelledby="devices-heading">
  <div class="max-container">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-bold uppercase tracking-wider">
        <Sparkles class="w-3.5 h-3.5" />
        <span>Full Kompatibilitet</span>
      </div>
      <h2 id="devices-heading" class="text-3xl sm:text-4xl md:text-5xl font-black text-white font-display tracking-tight">
        Kompatibel Med <span class="text-gradient-emerald">Alla Dina Enheter</span> & Appar
      </h2>
      <p class="text-base sm:text-lg text-slate-300">
        Streama sömlöst på din TV i vardagsrummet, på surfplattan i köket eller på mobilen när du är på språng. Vår tjänst fungerar överallt.
      </p>
    </div>

    <!-- Visual Devices Ecosystem Banner with Keyword Alt Text -->
  <div class="mb-12 flex justify-center">
    <img 
      src="/images/devices-mockup.svg" 
      alt="Bästa IPTV appen och kompatibla enheter för svensk IPTV på Smart TV, Apple TV och mobil" 
      class="w-full max-w-3xl rounded-3xl border border-white/10 shadow-2xl"
      loading="lazy"
      width="900"
      height="500"
    />
  </div>

  <!-- Devices Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {deviceCategories.map((cat) => (
        <div class="rounded-3xl p-7 glass-card border border-white/10 hover:border-emerald-500/40 transition-all duration-300 hover:-translate-y-1 flex flex-col justify-between group">
          <div>
            <!-- Category Header -->
            <div class="flex items-center justify-between mb-5">
              <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 group-hover:bg-emerald-500 group-hover:text-slate-950 transition-all duration-300 shadow-md">
                <cat.icon class="w-6 h-6" />
              </div>
              <span class="text-[11px] font-bold px-2.5 py-1 rounded-full bg-white/5 border border-white/10 text-slate-300">
                {cat.badge}
              </span>
            </div>

            <!-- Title & Description -->
            <h3 class="text-xl font-bold text-white mb-2 group-hover:text-emerald-300 transition-colors">
              {cat.title}
            </h3>
            <p class="text-xs text-slate-400 mb-6 leading-relaxed">
              {cat.description}
            </p>

            <!-- Device Items -->
            <ul class="space-y-2.5 text-xs text-slate-200">
              {cat.devices.map((device) => (
                <li class="flex items-center gap-2">
                  <CheckCircle class="w-3.5 h-3.5 text-emerald-400 shrink-0" />
                  <span>{device}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Bottom Action -->
          <div class="mt-6 pt-4 border-t border-white/5 text-xs font-semibold text-emerald-400 flex items-center justify-between">
            <span>Enkel 2-minuters setup</span>
            <span class="text-[10px] text-slate-500">M3U & Xtream Codes</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

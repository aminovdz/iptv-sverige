---
import { MessageCircle } from "lucide-astro";
---

<!-- Floating WhatsApp Support Button -->
<aside class="fixed bottom-6 right-6 z-50 flex items-center gap-3 group" aria-label="WhatsApp Kundsupport">
  <!-- Tooltip Message Bubble -->
  <div class="hidden sm:flex items-center gap-2 px-4 py-2 rounded-2xl glass-card-glow border border-emerald-500/40 bg-slate-950/95 text-xs text-slate-200 shadow-2xl transition-all duration-300 opacity-90 group-hover:opacity-100 group-hover:scale-105 pointer-events-none">
    <span class="flex h-2 w-2 relative">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
    </span>
    <span class="font-medium">Behöver du hjälp? <strong class="text-emerald-400">Chatta på WhatsApp</strong></span>
  </div>

  <!-- Main Floating Action Icon -->
  <a 
    href="https://wa.me/18036582620?text=Hej!%20Jag%20vill%20ha%20hjälp%20med%20IPTV%20Sverige."
    target="_blank" 
    rel="noopener noreferrer"
    class="relative w-14 h-14 rounded-full bg-gradient-to-tr from-emerald-500 to-emerald-400 flex items-center justify-center text-slate-950 shadow-2xl shadow-emerald-500/50 hover:scale-110 active:scale-95 transition-all duration-300 focus:outline-none focus:ring-4 focus:ring-emerald-400/40"
    aria-label="Öppna WhatsApp supportchatt"
  >
    <!-- Ping Ripple Effect -->
    <span class="animate-ping absolute -inset-1 rounded-full bg-emerald-400 opacity-30 pointer-events-none"></span>

    <!-- WhatsApp Icon -->
    <MessageCircle class="w-7 h-7 stroke-[2.5]" />

    <!-- Online Status Dot -->
    <span class="absolute top-0 right-0 w-3.5 h-3.5 rounded-full bg-emerald-300 border-2 border-slate-950"></span>
  </a>
</aside>

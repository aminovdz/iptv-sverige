---
import { MessageCircle, Send, X, BellRing, Sparkles, Check } from "lucide-astro";
---

<!-- Groups / Community Channels Modal -->
<div 
  id="groups-popup" 
  class="fixed inset-0 z-[90] hidden items-center justify-center p-4 bg-black/75 backdrop-blur-sm transition-opacity duration-300 opacity-0"
  role="dialog"
  aria-modal="true"
  aria-labelledby="groups-popup-title"
>
  <div 
    class="relative w-full max-w-md rounded-3xl p-7 glass-card-glow border-2 border-emerald-500/40 bg-gradient-to-b from-slate-900 via-slate-950 to-slate-950 shadow-2xl text-center space-y-6 transform scale-95 transition-transform duration-300"
    id="groups-popup-modal"
  >
    <!-- Close Button -->
    <button 
      id="close-groups-popup" 
      type="button" 
      class="absolute top-4 right-4 p-2 rounded-full bg-white/10 hover:bg-white/20 text-slate-300 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-emerald-400"
      aria-label="Stäng popup"
    >
      <X class="w-5 h-5" />
    </button>

    <!-- Header Icon -->
    <div class="inline-flex w-14 h-14 rounded-2xl bg-gradient-to-br from-emerald-400 to-blue-600 items-center justify-center text-slate-950 shadow-lg">
      <BellRing class="w-7 h-7 stroke-[2.5]" />
    </div>

    <!-- Main Headings -->
    <div class="space-y-2">
      <span class="inline-block px-3 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
        VIP COMMUNITY
      </span>
      
      <h3 id="groups-popup-title" class="text-2xl font-black text-white font-display tracking-tight">
        Gå Med i Våra <span class="text-gradient-emerald">Officiella Kanaler!</span>
      </h3>
      
      <p class="text-xs text-slate-300 leading-relaxed max-w-xs mx-auto">
        Få direkta matchpåminnelser (direktsänd fotboll & ishockey), driftsuppdateringar, rabattkoder och snabb kundservice.
      </p>
    </div>

    <!-- Channels Buttons Grid -->
    <div class="space-y-3 pt-1">
      <!-- WhatsApp Channel -->
      <a 
        href="https://whatsapp.com/channel/0029VayVaLpD8SE3bf8wMY3v" 
        target="_blank" 
        rel="noopener noreferrer"
        class="w-full p-4 rounded-2xl bg-emerald-500/15 hover:bg-emerald-500/25 border border-emerald-500/40 text-white font-bold text-sm flex items-center justify-between transition-all group"
      >
        <div class="flex items-center gap-3 text-left">
          <div class="w-10 h-10 rounded-xl bg-emerald-500 flex items-center justify-center text-slate-950 shrink-0">
            <MessageCircle class="w-5 h-5" />
          </div>
          <div>
            <div class="text-sm font-bold text-white group-hover:text-emerald-300">Officiell WhatsApp-Kanal</div>
            <div class="text-[11px] text-slate-400">Matchlänkar & exklusiva erbjudanden</div>
          </div>
        </div>
        <span class="text-xs font-bold text-emerald-400 bg-emerald-500/20 px-2.5 py-1 rounded-full">Gå med →</span>
      </a>

      <!-- Telegram Channel -->
      <a 
        href="https://t.me/castvera_com" 
        target="_blank" 
        rel="noopener noreferrer"
        class="w-full p-4 rounded-2xl bg-blue-500/15 hover:bg-blue-500/25 border border-blue-500/40 text-white font-bold text-sm flex items-center justify-between transition-all group"
      >
        <div class="flex items-center gap-3 text-left">
          <div class="w-10 h-10 rounded-xl bg-blue-500 flex items-center justify-center text-slate-950 shrink-0">
            <Send class="w-5 h-5" />
          </div>
          <div>
            <div class="text-sm font-bold text-white group-hover:text-blue-300">Officiell Telegram-Kanal</div>
            <div class="text-[11px] text-slate-400">Serverstatus & 24/7 supportnyheter</div>
          </div>
        </div>
        <span class="text-xs font-bold text-blue-400 bg-blue-500/20 px-2.5 py-1 rounded-full">Gå med →</span>
      </a>
    </div>

    <!-- Dismiss Text -->
    <div class="pt-1">
      <button 
        id="dismiss-groups-popup" 
        type="button" 
        class="text-[11px] text-slate-500 hover:text-slate-300 transition-colors"
      >
        Kanske senare
      </button>
    </div>

  </div>
</div>

<script>
  let groupsPopupShown = false;
  const groupsPopup = document.getElementById("groups-popup");
  const modal = document.getElementById("groups-popup-modal");
  const closeBtn = document.getElementById("close-groups-popup");
  const dismissBtn = document.getElementById("dismiss-groups-popup");

  function showGroupsPopup() {
    if (groupsPopupShown || sessionStorage.getItem("groups_popup_dismissed") === "true") return;
    groupsPopupShown = true;
    if (groupsPopup && modal) {
      groupsPopup.classList.remove("hidden");
      groupsPopup.classList.add("flex");
      setTimeout(() => {
        groupsPopup.classList.remove("opacity-0");
        groupsPopup.classList.add("opacity-100");
        modal.classList.remove("scale-95");
        modal.classList.add("scale-100");
      }, 20);
    }
  }

  function hideGroupsPopup() {
    if (groupsPopup && modal) {
      groupsPopup.classList.add("opacity-0");
      groupsPopup.classList.remove("opacity-100");
      modal.classList.add("scale-95");
      modal.classList.remove("scale-100");
      setTimeout(() => {
        groupsPopup.classList.add("hidden");
        groupsPopup.classList.remove("flex");
      }, 300);
      sessionStorage.setItem("groups_popup_dismissed", "true");
    }
  }

  // Trigger after 18 seconds
  setTimeout(showGroupsPopup, 18000);

  if (closeBtn) closeBtn.addEventListener("click", hideGroupsPopup);
  if (dismissBtn) dismissBtn.addEventListener("click", hideGroupsPopup);

  if (groupsPopup) {
    groupsPopup.addEventListener("click", (e) => {
      if (e.target === groupsPopup) hideGroupsPopup();
    });
  }
</script>

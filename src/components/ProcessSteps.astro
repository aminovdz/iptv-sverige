---
import { ShoppingBag, Send, PlayCircle, Clock, ShieldCheck, ArrowRight, Sparkles } from "lucide-astro";

const steps = [
  {
    step: "01",
    icon: ShoppingBag,
    title: "Välj Ditt Abonnemang",
    description: "Välj den tidsperiod som passar dig bäst (1, 3, 6 eller 12 månader). Vi rekommenderar 12-månaderspaketet för maximal besparing och 1 månad extra gratis.",
    time: "1 minut"
  },
  {
    step: "02",
    icon: Send,
    title: "Blixtsnabb Leverans & Swish",
    description: "Betala smidigt och säkert med Swish, Klarna eller betalkort. Dina M3U-länkar och Xtream Codes inloggningsuppgifter genereras automatiskt och skickas inom 5 minuter.",
    time: "Under 5 minuter"
  },
  {
    step: "03",
    icon: PlayCircle,
    title: "Ladda In & Börja Streama",
    description: "Mata in dina uppgifter i din favoritapp (t.ex. TiviMate eller IPTV Smarters på Smart TV/Apple TV). Vår steg-för-steg-guide gör installationen lekande lätt.",
    time: "Klart direkt!"
  }
];
---

<section id="process" class="py-20 relative overflow-hidden" aria-labelledby="process-heading">
  <div class="max-container">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-bold uppercase tracking-wider">
        <Sparkles class="w-3.5 h-3.5" />
        <span>Enkel Installation</span>
      </div>
      <h2 id="process-heading" class="text-3xl sm:text-4xl md:text-5xl font-black text-white font-display tracking-tight">
        Kom Igång Med <span class="text-gradient-emerald">IPTV Sverige</span> i 3 Enkla Steg
      </h2>
      <p class="text-base sm:text-lg text-slate-300">
        Inga krångliga boxar eller tekniska förkunskaper krävs. Du är igång och streamar dina svenska favoritkanaler på under 5 minuter.
      </p>
    </div>

    <!-- Steps Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
      {steps.map((item, index) => (
        <div class="relative rounded-3xl p-8 glass-card border border-white/10 hover:border-emerald-500/40 transition-all duration-300 hover:-translate-y-1 flex flex-col justify-between group">
          
          <!-- Step Number Watermark -->
          <div class="absolute top-6 right-6 text-5xl font-black font-display text-white/5 group-hover:text-emerald-500/10 transition-colors">
            {item.step}
          </div>

          <div>
            <!-- Step Icon & Badge -->
            <div class="flex items-center justify-between mb-6">
              <div class="w-14 h-14 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 group-hover:bg-emerald-500 group-hover:text-slate-950 transition-all duration-300 shadow-lg">
                <item.icon class="w-7 h-7" />
              </div>
              <span class="inline-flex items-center gap-1 text-[11px] font-bold text-amber-300 bg-amber-500/10 px-2.5 py-1 rounded-full border border-amber-500/20">
                <Clock class="w-3 h-3" />
                {item.time}
              </span>
            </div>

            <!-- Content -->
            <h3 class="text-xl font-bold text-white mb-3 group-hover:text-emerald-300 transition-colors">
              {item.title}
            </h3>
            <p class="text-sm text-slate-300 leading-relaxed">
              {item.description}
            </p>
          </div>

          <!-- Bottom Visual Indicator -->
          <div class="mt-6 pt-4 border-t border-white/5 flex items-center gap-2 text-xs font-semibold text-emerald-400">
            <span>Steg {index + 1} av 3</span>
            <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
          </div>

        </div>
      ))}
    </div>

    <!-- Quick Help & Trial Box -->
    <div class="mt-12 text-center">
      <p class="text-xs sm:text-sm text-slate-400">
        Behöver du personlig hjälp med att installera på din Smart TV? 
        <a href="https://wa.me/18036582620" target="_blank" rel="noopener noreferrer" class="text-emerald-400 underline decoration-emerald-600 hover:text-emerald-300 font-bold ml-1">
          Kontakta vår svenska support på WhatsApp för gratis hjälp steg för steg →
        </a>
      </p>
    </div>

  </div>
</section>

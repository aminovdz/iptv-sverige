---
import { Activity, Play, Radio, Sparkles, Trophy, Calendar, Clock, ArrowRight, ChevronLeft, ChevronRight, Zap } from "lucide-astro";
---

<section id="live-scores" class="py-14 md:py-20 relative overflow-hidden bg-slate-950/40 border-y border-white/5" aria-labelledby="sports-heading">
  <!-- Background Glow & Mesh Elements -->
  <div class="absolute inset-0 pointer-events-none z-0">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[350px] bg-gradient-to-r from-emerald-500/10 via-red-500/5 to-emerald-500/10 rounded-full blur-[140px] -z-10"></div>
  </div>

  <div class="max-container relative z-10 space-y-8">
    
    <!-- Section Header with Direct Match Center Redirection Link -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-2 border-b border-white/5">
      <div class="space-y-3 max-w-2xl">
        <a 
          href="/livescore" 
          class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-red-500/10 border border-red-500/30 text-red-400 text-xs font-bold uppercase tracking-wider hover:bg-red-500/20 transition-colors group"
          title="Klicka för att öppna Match Center"
        >
          <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
          <Activity class="w-3.5 h-3.5" />
          <span>Live Sport API • Direktuppdatering</span>
          <span class="text-slate-500">|</span>
          <span class="text-white group-hover:text-emerald-300 flex items-center gap-1">
            Öppna Match Center <ArrowRight class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" />
          </span>
        </a>
        
        <h2 id="sports-heading" class="text-2xl sm:text-3xl md:text-4xl font-black text-white font-display tracking-tight leading-tight">
          Live Score Matcher i <span class="text-gradient-emerald">60 FPS Ultra HD</span>
        </h2>
        
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
          Klicka på valfri match för att öppna vårt dedikerade <a href="/livescore" class="text-emerald-400 underline font-bold hover:text-emerald-300">/livescore Match Center</a>. Se direktsänd sport i 4K utan buffring eller sändningsfördröjning.
        </p>
      </div>

      <!-- Match Center Action Buttons -->
      <div class="flex items-center gap-3 shrink-0">
        <a 
          href="/livescore" 
          class="btn-primary py-2.5 px-5 text-xs sm:text-sm font-bold shadow-lg flex items-center gap-2"
        >
          <Trophy class="w-4 h-4" />
          <span>Öppna Match Center</span>
          <ArrowRight class="w-3.5 h-3.5" />
        </a>

        <!-- Carousel Manual Controls -->
        <div class="hidden sm:flex items-center gap-1.5 bg-white/5 p-1 rounded-xl border border-white/10">
          <button 
            type="button" 
            id="carousel-prev" 
            class="p-2 rounded-lg hover:bg-white/10 text-slate-300 hover:text-white transition-colors"
            title="Föregående matcher"
          >
            <ChevronLeft class="w-4 h-4" />
          </button>
          <button 
            type="button" 
            id="carousel-next" 
            class="p-2 rounded-lg hover:bg-white/10 text-slate-300 hover:text-white transition-colors"
            title="Nästa matcher"
          >
            <ChevronRight class="w-4 h-4" />
          </button>
        </div>
      </div>
    </div>

    <!-- League Selector Tabs -->
    <div class="flex items-center justify-start sm:justify-center gap-2 overflow-x-auto pb-2 scrollbar-none">
      <button 
        type="button" 
        class="league-btn active btn-primary px-4 py-2 text-xs font-bold shadow-md whitespace-nowrap"
        data-url="https://site.api.espn.com/apis/site/v2/sports/soccer/swe.1/scoreboard"
        data-league="Svensk Fotboll"
      >
        🇸🇪 Svensk Fotboll
      </button>

      <button 
        type="button" 
        class="league-btn glass-card px-4 py-2 hover:bg-white/10 transition-all rounded-full font-bold text-xs text-slate-300 border border-white/10 whitespace-nowrap"
        data-url="https://site.api.espn.com/apis/site/v2/sports/soccer/eng.1/scoreboard"
        data-league="Engelsk Fotboll"
      >
        🏴󠁧󠁢󠁥󠁮󠁧󠁿 Engelsk Fotboll
      </button>

      <button 
        type="button" 
        class="league-btn glass-card px-4 py-2 hover:bg-white/10 transition-all rounded-full font-bold text-xs text-slate-300 border border-white/10 whitespace-nowrap"
        data-url="https://site.api.espn.com/apis/site/v2/sports/soccer/uefa.champions/scoreboard"
        data-league="Europa Fotboll"
      >
        🏆 Europa Fotboll
      </button>

      <button 
        type="button" 
        class="league-btn glass-card px-4 py-2 hover:bg-white/10 transition-all rounded-full font-bold text-xs text-slate-300 border border-white/10 whitespace-nowrap"
        data-url="https://site.api.espn.com/apis/site/v2/sports/soccer/esp.1/scoreboard"
        data-league="Spansk Fotboll"
      >
        🇪🇸 Spansk Fotboll
      </button>

      <button 
        type="button" 
        class="league-btn glass-card px-4 py-2 hover:bg-white/10 transition-all rounded-full font-bold text-xs text-slate-300 border border-white/10 whitespace-nowrap"
        data-url="https://site.api.espn.com/apis/site/v2/sports/soccer/ita.1/scoreboard"
        data-league="Italiensk Fotboll"
      >
        🇮🇹 Italiensk Fotboll
      </button>

      <button 
        type="button" 
        class="league-btn glass-card px-4 py-2 hover:bg-white/10 transition-all rounded-full font-bold text-xs text-slate-300 border border-white/10 whitespace-nowrap"
        data-url="https://site.api.espn.com/apis/site/v2/sports/hockey/nhl/scoreboard"
        data-league="Ishockey"
      >
        🏒 Ishockey Live
      </button>

      <button 
        type="button" 
        class="league-btn glass-card px-4 py-2 hover:bg-white/10 transition-all rounded-full font-bold text-xs text-slate-300 border border-white/10 whitespace-nowrap"
        data-url="https://site.api.espn.com/apis/site/v2/sports/basketball/nba/scoreboard"
        data-league="Basket"
      >
        🏀 Basket Live
      </button>

      <button 
        type="button" 
        class="league-btn glass-card px-4 py-2 hover:bg-white/10 transition-all rounded-full font-bold text-xs text-red-400 border border-red-500/20 whitespace-nowrap"
        data-url="https://site.api.espn.com/apis/site/v2/sports/mma/ufc/scoreboard"
        data-type="mma"
        data-league="MMA / Kampsport"
      >
        🥊 MMA & Kampsport
      </button>
    </div>

    <!-- Infinite Loop Carousel Wrapper -->
    <div class="relative w-full overflow-hidden py-2" id="carousel-viewport">
      
      <!-- Side Fade Masks for Infinite Edge Effect -->
      <div class="pointer-events-none absolute left-0 top-0 bottom-0 w-12 sm:w-24 bg-gradient-to-r from-bg-dark to-transparent z-10"></div>
      <div class="pointer-events-none absolute right-0 top-0 bottom-0 w-12 sm:w-24 bg-gradient-to-l from-bg-dark to-transparent z-10"></div>

      <!-- Loading Indicator -->
      <div id="scores-loader" class="flex flex-col items-center justify-center py-16 space-y-3">
        <div class="w-10 h-10 border-3 border-emerald-500/20 border-t-emerald-400 rounded-full animate-spin"></div>
        <p class="text-xs text-slate-400 font-medium">Hämtar officiella matcher &amp; realtidsresultat...</p>
      </div>

      <!-- The Infinite Carousel Track -->
      <div id="carousel-track-container" class="hidden overflow-hidden w-full select-none cursor-grab active:cursor-grabbing">
        <div id="scores-track" class="flex items-center gap-5 w-max">
          <!-- Live Cards populated via JavaScript and cloned for seamless loop -->
        </div>
      </div>

    </div>

    <!-- Bottom Quality Reassurance Banner with Match Center Link -->
    <div class="rounded-2xl glass-card border border-emerald-500/30 p-4 sm:p-5 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-300">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Alla matcher sänds i <strong>4K Ultra HD @ 60 FPS</strong> med 0 sekunders fördröjning</span>
      </div>

      <div class="flex items-center gap-4">
        <a 
          href="/livescore" 
          class="text-emerald-400 font-bold hover:text-emerald-300 flex items-center gap-1.5 transition-colors"
        >
          <Trophy class="w-3.5 h-3.5 text-amber-400" />
          <span>Gå till Match Center för Tabeller &amp; Fler Ligor</span>
          <ArrowRight class="w-3.5 h-3.5" />
        </a>
      </div>
    </div>

  </div>
</section>

<style>
  /* Seamless Infinite Animation */
  @keyframes infinite-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .carousel-scrolling {
    animation: infinite-scroll 45s linear infinite;
  }

  .carousel-scrolling:hover,
  .carousel-paused {
    animation-play-state: paused !important;
  }
</style>

<script>
  const loader = document.getElementById("scores-loader");
  const trackContainer = document.getElementById("carousel-track-container");
  const track = document.getElementById("scores-track");
  const buttons = document.querySelectorAll(".league-btn");
  const prevBtn = document.getElementById("carousel-prev");
  const nextBtn = document.getElementById("carousel-next");

  const defaultFallbackMatches: Record<string, any[]> = {
    "Svensk Fotboll": [
      { homeTeam: "Malmö FF", awayTeam: "AIK", homeScore: "2", awayScore: "1", status: "LIVE 78'", isLive: true, date: new Date().toISOString(), homeLogo: "https://a.espncdn.com/combiner/i?img=/i/teamlogos/soccer/500/2157.png", awayLogo: "https://a.espncdn.com/combiner/i?img=/i/teamlogos/soccer/500/103.png" },
      { homeTeam: "Djurgårdens IF", awayTeam: "Hammarby IF", homeScore: "-", awayScore: "-", status: "Ikväll 19:10", isLive: false, date: new Date().toISOString(), homeLogo: "https://a.espncdn.com/combiner/i?img=/i/teamlogos/soccer/500/775.png", awayLogo: "https://a.espncdn.com/combiner/i?img=/i/teamlogos/soccer/500/1188.png" },
      { homeTeam: "IFK Göteborg", awayTeam: "IF Elfsborg", homeScore: "1", awayScore: "0", status: "Slutresultat", isLive: false, date: new Date().toISOString(), homeLogo: "https://a.espncdn.com/combiner/i?img=/i/teamlogos/soccer/500/1190.png", awayLogo: "https://a.espncdn.com/combiner/i?img=/i/teamlogos/soccer/500/1189.png" },
      { homeTeam: "BK Häcken", awayTeam: "IFK Norrköping", homeScore: "3", awayScore: "2", status: "Slutresultat", isLive: false, date: new Date().toISOString(), homeLogo: "https://a.espncdn.com/combiner/i?img=/i/teamlogos/soccer/500/776.png", awayLogo: "https://a.espncdn.com/combiner/i?img=/i/teamlogos/soccer/500/1191.png" },
      { homeTeam: "Kalmar FF", awayTeam: "Halmstads BK", homeScore: "-", awayScore: "-", status: "Imorgon 15:00", isLive: false, date: new Date().toISOString(), homeLogo: "https://a.espncdn.com/combiner/i?img=/i/teamlogos/soccer/500/1192.png", awayLogo: "https://a.espncdn.com/combiner/i?img=/i/teamlogos/soccer/500/1193.png" }
    ],
    "Engelsk Fotboll": [
      { homeTeam: "Arsenal", awayTeam: "Chelsea", homeScore: "2", awayScore: "1", status: "LIVE 64'", isLive: true, date: new Date().toISOString(), homeLogo: "https://a.espncdn.com/combiner/i?img=/i/teamlogos/soccer/500/359.png", awayLogo: "https://a.espncdn.com/combiner/i?img=/i/teamlogos/soccer/500/363.png" },
      { homeTeam: "Liverpool", awayTeam: "Manchester City", homeScore: "-", awayScore: "-", status: "Idag 17:30", isLive: false, date: new Date().toISOString(), homeLogo: "https://a.espncdn.com/combiner/i?img=/i/teamlogos/soccer/500/364.png", awayLogo: "https://a.espncdn.com/combiner/i?img=/i/teamlogos/soccer/500/382.png" },
      { homeTeam: "Tottenham", awayTeam: "Manchester United", homeScore: "3", awayScore: "2", status: "Slutresultat", isLive: false, date: new Date().toISOString(), homeLogo: "https://a.espncdn.com/combiner/i?img=/i/teamlogos/soccer/500/367.png", awayLogo: "https://a.espncdn.com/combiner/i?img=/i/teamlogos/soccer/500/360.png" },
      { homeTeam: "Aston Villa", awayTeam: "Newcastle", homeScore: "1", awayScore: "1", status: "Slutresultat", isLive: false, date: new Date().toISOString(), homeLogo: "https://a.espncdn.com/combiner/i?img=/i/teamlogos/soccer/500/362.png", awayLogo: "https://a.espncdn.com/combiner/i?img=/i/teamlogos/soccer/500/361.png" }
    ]
  };

  async function fetchLiveScores(url: string, type: string, leagueName: string) {
    if (!loader || !trackContainer || !track) return;
    
    loader.classList.remove("hidden");
    trackContainer.classList.add("hidden");
    track.classList.remove("carousel-scrolling");
    track.innerHTML = "";

    try {
      const response = await fetch(url, { cache: "no-store" });
      if (!response.ok) throw new Error("HTTP error " + response.status);
      const data = await response.json();
      
      let events = data.events || [];
      if (type === "mma" && events.length > 0) {
        let fights: any[] = [];
        events.forEach((e: any) => {
          if (e.competitions) fights.push(...e.competitions);
        });
        events = fights;
      }

      if (events.length === 0) {
        const fallbacks = defaultFallbackMatches[leagueName] || defaultFallbackMatches["Svensk Fotboll"];
        renderCarousel(fallbacks, leagueName);
      } else {
        const parsedEvents = events.slice(0, 10).map((event: any) => {
          const comp = type === "mma" ? event : (event.competitions ? event.competitions[0] : event);
          let home: any, away: any;

          if (type === "mma") {
            home = comp.competitors ? comp.competitors[0] : null;
            away = comp.competitors ? comp.competitors[1] : null;
          } else {
            home = comp.competitors ? comp.competitors.find((c: any) => c.homeAway === "home") || comp.competitors[0] : null;
            away = comp.competitors ? comp.competitors.find((c: any) => c.homeAway === "away") || comp.competitors[1] : null;
          }

          if (!home || !away) return null;

          const homeName = type === "mma" ? (home.athlete?.shortName || home.athlete?.displayName || "Kämpe 1") : (home.team?.displayName || home.team?.name || "Hemmalag");
          const awayName = type === "mma" ? (away.athlete?.shortName || away.athlete?.displayName || "Kämpe 2") : (away.team?.displayName || away.team?.name || "Bortalag");

          const homeLogo = type === "mma" ? (home.athlete?.flag?.href || "") : (home.team?.logo || "");
          const awayLogo = type === "mma" ? (away.athlete?.flag?.href || "") : (away.team?.logo || "");

          const statusObj = type === "mma" ? comp.status?.type : event.status?.type;
          const isLive = statusObj?.state === "in";
          const statusDetail = statusObj?.detail || (isLive ? "LIVE" : "Kommande");

          return {
            homeTeam: homeName,
            awayTeam: awayName,
            homeScore: home.score !== undefined ? home.score : "-",
            awayScore: away.score !== undefined ? away.score : "-",
            status: statusDetail,
            isLive: isLive,
            date: event.date || new Date().toISOString(),
            homeLogo: homeLogo,
            awayLogo: awayLogo,
            type: type
          };
        }).filter(Boolean);

        if (parsedEvents.length === 0) {
          const fallbacks = defaultFallbackMatches[leagueName] || defaultFallbackMatches["Svensk Fotboll"];
          renderCarousel(fallbacks, leagueName);
        } else {
          renderCarousel(parsedEvents, leagueName);
        }
      }
    } catch (error) {
      console.warn("Live sports API fetch fallback:", error);
      const fallbacks = defaultFallbackMatches[leagueName] || defaultFallbackMatches["Svensk Fotboll"];
      renderCarousel(fallbacks, leagueName);
    } finally {
      loader.classList.add("hidden");
      trackContainer.classList.remove("hidden");
      // Start infinite animation once rendered
      setTimeout(() => {
        track.classList.add("carousel-scrolling");
      }, 50);
    }
  }

  function createCardElement(m: any, leagueName: string) {
    // All fixture cards link seamlessly directly to the dedicated Match Center
    const card = document.createElement("a");
    card.href = "/livescore";
    card.className = "fixture-card flex-shrink-0 w-[290px] sm:w-[330px] rounded-2xl p-4 sm:p-5 bg-slate-900/90 hover:bg-slate-850 border border-white/10 hover:border-emerald-400/60 shadow-lg hover:shadow-2xl hover:shadow-emerald-500/10 transition-all duration-300 flex flex-col justify-between space-y-4 group cursor-pointer relative overflow-hidden block";
    card.title = `Klicka för att se ${m.homeTeam} vs ${m.awayTeam} i Match Center`;

    let statusHtml = "";
    if (m.isLive) {
      statusHtml = `<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-red-500/20 text-red-400 border border-red-500/30 text-[10px] font-black uppercase tracking-wider animate-pulse"><span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-ping"></span>${m.status}</span>`;
    } else if (m.status.toLowerCase().includes("slut") || m.status.toLowerCase().includes("final") || m.status.toLowerCase().includes("ft")) {
      statusHtml = `<span class="text-slate-400 bg-white/5 px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase">Slut</span>`;
    } else {
      statusHtml = `<span class="text-emerald-400 bg-emerald-500/10 px-2.5 py-0.5 rounded-full text-[10px] font-bold">${m.status}</span>`;
    }

    const formattedDate = m.date ? new Date(m.date).toLocaleDateString("sv-SE", { month: "short", day: "numeric" }) : "Idag";

    card.innerHTML = `
      <!-- Card Glow Accent on Hover -->
      <div class="absolute inset-0 bg-gradient-to-r from-emerald-500/0 via-emerald-500/5 to-emerald-500/0 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"></div>

      <!-- Top Header -->
      <div class="flex items-center justify-between text-xs pb-2 border-b border-white/5 relative z-10">
        <div class="flex items-center gap-1.5 text-slate-400 font-bold">
          <span class="text-[11px] text-emerald-400 font-mono">${leagueName}</span>
          <span class="text-slate-600">•</span>
          <span class="text-[10px] text-slate-400">${formattedDate}</span>
        </div>
        ${statusHtml}
      </div>

      <!-- Teams & Score Display -->
      <div class="flex items-center justify-between gap-3 py-1 relative z-10">
        <!-- Home Team -->
        <div class="flex flex-col items-center text-center flex-1 min-w-0">
          ${m.homeLogo ? `<img src="${m.homeLogo}" alt="${m.homeTeam}" class="w-11 h-11 object-contain mb-1.5 p-1 rounded-xl bg-white/5 border border-white/10" loading="lazy" onerror="this.style.display='none'" />` : `<div class="w-11 h-11 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-sm font-bold text-white mb-1.5">⚽</div>`}
          <span class="text-xs font-bold text-white truncate max-w-full leading-tight group-hover:text-emerald-300 transition-colors">${m.homeTeam}</span>
        </div>

        <!-- Score / VS Box -->
        <div class="flex flex-col items-center justify-center px-2 shrink-0">
          ${m.type === "mma" ? `
            <span class="text-sm font-black text-amber-400 font-display">VS</span>
          ` : `
            <div class="text-xl sm:text-2xl font-black font-mono tracking-tight ${m.isLive ? "text-emerald-400" : "text-white"}">
              ${m.homeScore !== undefined && m.homeScore !== "-" ? `${m.homeScore} <span class="text-slate-600 text-sm">:</span> ${m.awayScore}` : `<span class="text-xs font-bold text-slate-400 px-2 py-0.5 rounded bg-white/5 font-sans">VS</span>`}
            </div>
          `}
          <span class="text-[8px] font-bold text-emerald-400/80 uppercase tracking-widest mt-1">4K 60FPS</span>
        </div>

        <!-- Away Team -->
        <div class="flex flex-col items-center text-center flex-1 min-w-0">
          ${m.awayLogo ? `<img src="${m.awayLogo}" alt="${m.awayTeam}" class="w-11 h-11 object-contain mb-1.5 p-1 rounded-xl bg-white/5 border border-white/10" loading="lazy" onerror="this.style.display='none'" />` : `<div class="w-11 h-11 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-sm font-bold text-white mb-1.5">⚽</div>`}
          <span class="text-xs font-bold text-white truncate max-w-full leading-tight group-hover:text-emerald-300 transition-colors">${m.awayTeam}</span>
        </div>
      </div>

      <!-- Action Indicator Footer -->
      <div class="pt-2.5 border-t border-white/5 flex items-center justify-between text-xs relative z-10">
        <span class="text-[10px] text-slate-400 font-mono flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Match Center
        </span>
        <span class="text-[11px] text-emerald-400 font-bold group-hover:text-emerald-300 flex items-center gap-1 group-hover:translate-x-1 transition-all">
          <span>Se Match</span>
          <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
        </span>
      </div>
    `;

    return card;
  }

  function renderCarousel(matches: any[], leagueName = "Sport") {
    if (!track) return;
    track.innerHTML = "";

    // Ensure we have at least 6-8 items for a smooth infinite loop
    let loopMatches = [...matches];
    while (loopMatches.length < 6) {
      loopMatches = [...loopMatches, ...matches];
    }

    // Clone the set twice to construct seamless infinite loop track: [A, B, C, ... A, B, C, ...]
    const combinedSet = [...loopMatches, ...loopMatches];

    combinedSet.forEach(m => {
      const card = createCardElement(m, leagueName);
      track.appendChild(card);
    });
  }

  // Handle Tab Switch
  buttons.forEach(btn => {
    btn.addEventListener("click", (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      
      buttons.forEach(b => {
        b.className = "league-btn glass-card px-4 py-2 hover:bg-white/10 transition-all rounded-full font-bold text-xs text-slate-300 border border-white/10 whitespace-nowrap";
        if (b.getAttribute("data-type") === "mma") {
          b.classList.add("text-red-400", "border-red-500/20");
        }
      });
      target.className = "league-btn active btn-primary px-4 py-2 font-bold text-xs shadow-md whitespace-nowrap";

      const url = target.getAttribute("data-url");
      const type = target.getAttribute("data-type") || "team";
      const leagueName = target.getAttribute("data-league") || "Svensk Fotboll";
      if (url) fetchLiveScores(url, type, leagueName);
    });
  });

  // Carousel Next / Prev Controls
  if (prevBtn && nextBtn && track) {
    prevBtn.addEventListener("click", () => {
      track.classList.add("carousel-paused");
      track.scrollBy({ left: -340, behavior: "smooth" });
      setTimeout(() => track.classList.remove("carousel-paused"), 2000);
    });

    nextBtn.addEventListener("click", () => {
      track.classList.add("carousel-paused");
      track.scrollBy({ left: 340, behavior: "smooth" });
      setTimeout(() => track.classList.remove("carousel-paused"), 2000);
    });
  }

  // Initial Load with first tab (Svensk Fotboll)
  const defaultBtn = document.querySelector(".league-btn.active");
  const defaultUrl = defaultBtn?.getAttribute("data-url");
  const defaultType = defaultBtn?.getAttribute("data-type") || "team";
  const defaultLeague = defaultBtn?.getAttribute("data-league") || "Svensk Fotboll";
  if (defaultUrl) {
    fetchLiveScores(defaultUrl, defaultType, defaultLeague);
  }
</script>

---
import Layout from "../../layouts/Layout.astro";
import StickyHeader from "../../components/StickyHeader.astro";
import PricingCard from "../../components/PricingCard.astro";
import FAQSection from "../../components/FAQSection.astro";
import CTASection from "../../components/CTASection.astro";
import Footer from "../../components/Footer.astro";
import FloatingWhatsApp from "../../components/FloatingWhatsApp.astro";
import ExitPopup from "../../components/ExitPopup.astro";
import GroupsPopup from "../../components/GroupsPopup.astro";
import SocialPopup from "../../components/SocialPopup.astro";
import { Check, X, ShieldCheck, Zap, Star, Trophy, Sparkles, ArrowRight } from "lucide-astro";

export function getStaticPaths() {
  const comparisons = [
    {
      slug: "iptv-sverige-vs-testaiptv",
      competitorName: "TestaIPTV",
      competitorType: "Katalog & Återförsäljarsajt",
      summary: "Medan TestaIPTV agerar som en tredjepartsförmedlare med spridda betyg och ojämn serverkvalitet, levererar IPTV Sverige direkta dedikerade servrar i Stockholm, 60 FPS sändningar och personlig svensk support via WhatsApp.",
      winnerScoreUs: "9.8 / 10",
      winnerScoreComp: "7.1 / 10",
      metrics: [
        { feature: "Serverplacering", us: "Stockholm (Lokala CDN-noder)", comp: "Utländska proxy-servrar", usWins: true },
        { feature: "Drifttid under stora sportevenemang", us: "99.9% (Anti-Freeze 9.0)", comp: "Frekvent buffring vid hög belastning", usWins: true },
        { feature: "Supportkanaler", us: "WhatsApp & Telegram 24/7 (Svenska)", comp: "Endast e-postformulär", usWins: true },
        { feature: "Betalningsmetoder", us: "Swish, Klarna, Kort, Krypto", comp: "Kort & Krypto (Ej direkt Swish)", usWins: true },
        { feature: "EPG & Programtablå", us: "Automatisk i svensk tid (GMT+1)", comp: "Ofta felaktig tidskod", usWins: true },
        { feature: "Provperiod", us: "24h Gratis Provperiod", comp: "Tidsbegränsad 1 timme", usWins: true }
      ]
    },
    {
      slug: "iptv-sverige-vs-streamisly",
      competitorName: "Streamisly",
      competitorType: "Generisk IPTV-leverantör",
      summary: "Streamisly saknar svensk anpassning och lokal servernärvaro. IPTV Sverige erbjuder skräddarsytt svenskt sportfokus, garanterad 60 FPS och fullt stöd för Swish.",
      winnerScoreUs: "9.8 / 10",
      winnerScoreComp: "6.8 / 10",
      metrics: [
        { feature: "Svensk lokalisering & E-E-A-T", us: "100% Svensk text, support & EPG", comp: "Engelska/Svenska blandad webbplats", usWins: true },
        { feature: "Bildkvalitet på Svensk Sport", us: "Äkta 4K UHD & 60 FPS", comp: "Komprimerad 25–30 FPS", usWins: true },
        { feature: "Betalning med Swish", us: "Ja, omedelbar aktivering", comp: "Nej, endast internationell kortbetalning", usWins: true },
        { feature: "Återbetalningsgaranti", us: "24 timmars full returrätt", comp: "Ingen tydlig återbetalningspolicy", usWins: true },
        { feature: "Laddtider & Sajtprestanda", us: "Blixtsnabb Astro-arkitektur", comp: "Långsam WordPress-plattform", usWins: true }
      ]
    },
    {
      slug: "iptv-sverige-vs-nordic-iptv",
      competitorName: "Nordic IPTV",
      competitorType: "Återförsäljare & Blogg",
      summary: "Nordic IPTV är ett välkänt namn i Sverige men lider ofta av serverfrysningar under stora matcher och långsamma svarstider. IPTV Sverige erbjuder dedikerade servrar i Stockholm, Anti-Freeze 9.0 och svensk WhatsApp-support inom 2 minuter.",
      winnerScoreUs: "9.8 / 10",
      winnerScoreComp: "7.2 / 10",
      metrics: [
        { feature: "Serverdrifttid & Anti-Freeze", us: "99.9% Upptid (Servrar i Stockholm)", comp: "Överbelastade under stormatcher", usWins: true },
        { feature: "Pris (12 Månader VIP)", us: "600 SEK (50 kr/mån + 1 Mån Gratis)", comp: "995–1395 SEK", usWins: true },
        { feature: "Aktiveringstid med Swish", us: "Under 3 minuter 24/7", comp: "1–6 timmar (manuell hantering)", usWins: true },
        { feature: "Supportkanaler", us: "WhatsApp & Telegram direktkontakt", comp: "Endast e-post & kontaktformulär", usWins: true },
        { feature: "Provperiod", us: "24h Gratis Provperiod", comp: "Kräver betalning för test", usWins: true },
        { feature: "Svensk EPG & Programtablå", us: "100% Synkad i svensk tid", comp: "Ofta felaktiga tidszoner", usWins: true }
      ]
    },
    {
      slug: "iptv-sverige-vs-iptvking",
      competitorName: "IPTV King",
      competitorType: "Tredjeparts IPTV-leverantör",
      summary: "IPTV King har ett brett utbud men saknar svensk infrastruktur och direkt WhatsApp-support. IPTV Sverige ger överlägsen 4K bildkvalitet med 60 FPS och omedelbar Swish-aktivering.",
      winnerScoreUs: "9.8 / 10",
      winnerScoreComp: "7.0 / 10",
      metrics: [
        { feature: "Svensk Servernärvaro", us: "Lokala CDN-noder i Stockholm", comp: "Utländska servrar (högre latens)", usWins: true },
        { feature: "Prisvärdhet (12 Månader)", us: "600 SEK (50 kr/mån)", comp: "1100–1400 SEK", usWins: true },
        { feature: "Betalning med Swish", us: "Ja, direkt i WhatsApp", comp: "Ofta begränsat till Krypto/Kort", usWins: true },
        { feature: "Återbetalningspolicy", us: "24h Full Återbetalningsgaranti", comp: "Ingen återbetalning", usWins: true },
        { feature: "Bildflyt på Sport", us: "60 FPS i äkta 4K UHD", comp: "Varierande 25–30 FPS", usWins: true }
      ]
    },
    {
      slug: "iptv-sverige-vs-nordstream",
      competitorName: "Nordstream",
      competitorType: "Nordisk Blogg & Tjänst",
      summary: "Nordstream erbjuder bra guider men har begränsad teknisk flexibilitet. IPTV Sverige ger snabbare kanalväxling, personlig WhatsApp-support och överlägsen serverupptid under stormatcher.",
      winnerScoreUs: "9.8 / 10",
      winnerScoreComp: "7.9 / 10",
      metrics: [
        { feature: "Serverlatens i Sverige", us: "Under 10ms (Lokala knutpunkter)", comp: "25–40ms", usWins: true },
        { feature: "Prisvärdhet (12 Månader)", us: "600 SEK (50 kr/mån + 1 mån gratis)", comp: "899–1299 SEK", usWins: true },
        { feature: "Live Sportcenter i 60 FPS", us: "Ja, dedikerat sportnätverk", comp: "Standard strömmar", usWins: true },
        { feature: "Direktkontakt WhatsApp", us: "Svar inom 2 minuter dygnet runt", comp: "Begränsad svarstid", usWins: true }
      ]
    },
    {
      slug: "iptv-sverige-vs-kabel-tv",
      competitorName: "Traditionell Kabel-TV",
      competitorType: "Kabeloperatörer (Traditionella Operatörer)",
      summary: "Traditionell kabel-TV kostar tusentals kronor per år och låser in dig i långa bindningstider. IPTV Sverige ger dig samma innehåll i högre bildkvalitet till en bråkdel av priset utan bindningstid.",
      winnerScoreUs: "9.8 / 10",
      winnerScoreComp: "5.5 / 10",
      metrics: [
        { feature: "Månadskostnad", us: "Från 50 kr/mån", comp: "499–899 kr/mån", usWins: true },
        { feature: "Bindningstid", us: "0 månader (Ingen bindningstid)", comp: "12–24 månader", usWins: true },
        { feature: "Hårdvarukrav", us: "Fungerar på din befintliga Smart TV", comp: "Kräver extern box & kabeldragning", usWins: true },
        { feature: "Flexibilitet (Ta med på resa)", us: "Streama var du vill i världen", comp: "Låst till hemadressen", usWins: true },
        { feature: "Svenskt & Internationellt Sportpaket", us: "Ingår i standardabonnemanget", comp: "Kräver dyra tillvalspaket (499+ kr)", usWins: true }
      ]
    }
  ];

  return comparisons.map(comp => ({
    params: { slug: comp.slug },
    props: { compData: comp }
  }));
}

const { compData } = Astro.props;

const breadcrumbs = [
  { name: "Hem", url: "/" },
  { name: "Jämförelser", url: "/basta-iptv" },
  { name: `IPTV Sverige vs ${compData.competitorName}`, url: `/compare/${compData.slug}` }
];
---

<Layout 
  title={`IPTV Sverige vs ${compData.competitorName} (2026 Jämförelse & Test)`}
  description={`Ärlig och oberoende jämförelse mellan IPTV Sverige och ${compData.competitorName}. Se priser, bildkvalitet i 4K, stabilitet och support.`}
  breadcrumbItems={breadcrumbs}
>
  <StickyHeader slot="header" />

  <div class="py-16 md:py-24 relative overflow-hidden">
    <div class="max-container">
      
      <!-- Comparison Hero Header -->
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
        <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-bold uppercase tracking-wider">
          <Trophy class="w-3.5 h-3.5 text-amber-400" />
          <span>Oberoende Svensk Jämförelse 2026</span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-white font-display tracking-tight leading-tight">
          IPTV Sverige vs <span class="text-gradient-emerald">{compData.competitorName}</span>
        </h1>

        <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
          {compData.summary}
        </p>
      </div>

      <!-- Scoreboard Cards Comparison -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16 max-w-4xl mx-auto">
        
        <!-- IPTV Sverige (Winner Card) -->
        <div class="rounded-3xl p-8 glass-card-glow border-2 border-emerald-500/60 bg-gradient-to-b from-slate-900 via-emerald-950/40 to-slate-950 shadow-2xl relative">
          <div class="absolute -top-3.5 right-6 px-3.5 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-emerald-500 text-slate-950 shadow-md flex items-center gap-1">
            <Trophy class="w-3.5 h-3.5" />
            <span>TESTVINNARE</span>
          </div>

          <div class="flex items-center justify-between mb-4">
            <h2 class="text-2xl font-black text-white font-display">🇸🇪 IPTV Sverige</h2>
            <div class="text-3xl font-black text-emerald-400 font-display">{compData.winnerScoreUs}</div>
          </div>
          <p class="text-xs text-slate-300 mb-6">Officiell ledande svensk streamingplattform med lokala servrar i Stockholm och 24/7 Swish-aktivering.</p>

          <div class="space-y-2 text-xs text-slate-200">
            <div class="flex items-center gap-2 text-emerald-300 font-semibold">
              <Check class="w-4 h-4 text-emerald-400" /> 99.9% Upptidsgaranti & Anti-Freeze 9.0
            </div>
            <div class="flex items-center gap-2 text-emerald-300 font-semibold">
              <Check class="w-4 h-4 text-emerald-400" /> Direktsänd Sport i 60 FPS
            </div>
            <div class="flex items-center gap-2 text-emerald-300 font-semibold">
              <Check class="w-4 h-4 text-emerald-400" /> Swish & Klarna aktivering på 5 min
            </div>
          </div>

          <div class="mt-8 pt-6 border-t border-white/10">
            <a href="/#pricing" class="btn-primary w-full py-3.5 text-center text-sm font-bold shadow-lg">
              Välj IPTV Sverige & Spara 65%
            </a>
          </div>
        </div>

        <!-- Competitor Card -->
        <div class="rounded-3xl p-8 glass-card border border-white/10 bg-slate-900/60 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-2xl font-bold text-slate-300 font-display">{compData.competitorName}</h2>
              <div class="text-2xl font-bold text-slate-400 font-display">{compData.winnerScoreComp}</div>
            </div>
            <p class="text-xs text-slate-400 mb-6">{compData.competitorType}</p>

            <div class="space-y-2 text-xs text-slate-400">
              <div class="flex items-center gap-2">
                <span class="text-slate-500">✕</span> Ojämn prestanda vid derbykvällar
              </div>
              <div class="flex items-center gap-2">
                <span class="text-slate-500">✕</span> Begränsade lokala betalningslösningar
              </div>
              <div class="flex items-center gap-2">
                <span class="text-slate-500">✕</span> Längre svarstider hos supporten
              </div>
            </div>
          </div>

          <div class="mt-8 pt-6 border-t border-white/10 text-center">
            <a 
              href="https://wa.me/18036582620?text=Hej!%20Jag%20vill%20testa%20IPTV%20Sverige%20gratis%20istället."
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-emerald-400 hover:text-emerald-300 underline font-bold"
            >
              Testa IPTV Sverige gratis i 24h istället →
            </a>
          </div>
        </div>

      </div>

      <!-- Detailed Feature Matrix Table -->
      <div class="rounded-3xl glass-card border border-white/10 p-6 sm:p-10 shadow-2xl mb-16">
        <h3 class="text-2xl font-bold text-white mb-6 text-center font-display">
          Fullständig Funktionsjämförelse
        </h3>

        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse min-w-[600px]">
            <thead>
              <tr class="border-b border-white/10 text-xs uppercase tracking-wider font-bold">
                <th class="py-4 px-4 text-slate-400">Kriterium</th>
                <th class="py-4 px-4 text-emerald-400 bg-emerald-500/10 rounded-t-xl">🇸🇪 IPTV Sverige</th>
                <th class="py-4 px-4 text-slate-400">{compData.competitorName}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5 text-sm">
              {compData.metrics.map((row) => (
                <tr class="hover:bg-white/[0.02] transition-colors">
                  <td class="py-4 px-4 font-semibold text-slate-200">{row.feature}</td>
                  <td class="py-4 px-4 font-bold text-emerald-300 bg-emerald-500/5 flex items-center gap-2">
                    <Check class="w-4 h-4 text-emerald-400 shrink-0" />
                    <span>{row.us}</span>
                  </td>
                  <td class="py-4 px-4 text-slate-400">{row.comp}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </div>

  <PricingCard />
  <FAQSection />
  <CTASection />

  <Footer slot="footer" />

  <Fragment slot="widgets">
    <FloatingWhatsApp />
    <GroupsPopup />
    <ExitPopup />
    <SocialPopup />
  </Fragment>
</Layout>

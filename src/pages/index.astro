---
import Layout from "../layouts/Layout.astro";
import StickyHeader from "../components/StickyHeader.astro";
import Hero from "../components/Hero.astro";
import LiveScores from "../components/LiveScores.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import PricingCard from "../components/PricingCard.astro";
import ReferralBanner from "../components/ReferralBanner.astro";
import UserReviewsSection from "../components/UserReviewsSection.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import SupportedDevices from "../components/SupportedDevices.astro";
import CitiesList from "../components/CitiesList.astro";
import ContactForm from "../components/ContactForm.astro";
import FAQSection from "../components/FAQSection.astro";
import FeaturedGuides from "../components/FeaturedGuides.astro";
import CTASection from "../components/CTASection.astro";
import Footer from "../components/Footer.astro";
import FloatingWhatsApp from "../components/FloatingWhatsApp.astro";
import GroupsPopup from "../components/GroupsPopup.astro";
import ExitPopup from "../components/ExitPopup.astro";
import SocialPopup from "../components/SocialPopup.astro";
import { CURRENT_YEAR } from "../utils/date";

const breadcrumbs = [
  { name: "Hem", url: "/" }
];

const homeProductSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "IPTV Sverige — Sveriges Bästa IPTV Tjänst",
  "image": "https://iptv-sverige.org/favicon.svg",
  "description": "Sveriges ledande IPTV leverantör med 4K UHD streaming, direktsänd sport, film och underhållning utan buffring.",
  "brand": {
    "@type": "Brand",
    "name": "IPTV Sverige"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "1450"
  },
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "SEK",
    "lowPrice": "89",
    "highPrice": "600",
    "offerCount": "4"
  }
};
---

<Layout 
  title={`IPTV Sverige ${CURRENT_YEAR} — Streama Svensk TV & Sport i 4K & 8K`} 
  description="Upplev Sveriges mest stabila IPTV-tjänst med 99.9% drifttid. Se direktsänd sport, film & serier i 4K UHD utan buffring. Testa gratis 24h & betala tryggt med Swish!"
  schema={homeProductSchema}
  breadcrumbItems={breadcrumbs}
>
  <StickyHeader slot="header" currentPath="/" />

  <!-- 1. Hero Section -->
  <Hero 
    h1Title="IPTV Sverige — Streama Svensk TV & Sport i Kristallklar 4K & 8K"
    primaryKeyword="IPTV Sverige"
  />

  <!-- 2. Live Scores / Sports Tracker Widget -->
  <LiveScores />

  <!-- 3. Features Grid & Comparison Matrix -->
  <FeatureGrid />

  <!-- 4. Pricing Tiers (12-Month Plan Prominently First) -->
  <PricingCard />

  <!-- 5. Referrer / Viral Growth Banner -->
  <ReferralBanner />

  <!-- 6. Testimonials & Verified Swedish Reviews -->
  <UserReviewsSection />

  <!-- 7. How it Works / 3-Step Process -->
  <ProcessSteps />

  <!-- 8. Supported Devices & IPTV Apps -->
  <SupportedDevices />

  <!-- 9. Programmatic Swedish Cities Directory -->
  <CitiesList />

  <!-- 10. Contact Section -->
  <ContactForm />

  <!-- 11. Long-Tail FAQ with FAQPage Schema -->
  <FeaturedGuides />

  <!-- 11. Long-Tail FAQ with FAQPage Schema -->
  <FAQSection />

  <!-- 12. Final High-Converting CTA -->
  <CTASection 
    title="Börja Streama Svensk IPTV i 4K Redan Idag"
    subtitle="Få omedelbar tillgång till Sveriges ledande IPTV-abonnemang med Anti-Freeze servrar, svensk EPG och 24/7 support. Inga bindningstider."
  />

  <!-- Footer -->
  <Footer slot="footer" />

  <!-- Interactive Engagement Widgets -->
  <Fragment slot="widgets">
    <FloatingWhatsApp />
    <GroupsPopup />
    <ExitPopup />
    <SocialPopup />
  </Fragment>
</Layout>

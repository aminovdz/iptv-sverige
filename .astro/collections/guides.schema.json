{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "pubDate": {
      "type": "string",
      "format": "date-time"
    },
    "updatedDate": {
      "type": "string",
      "format": "date-time"
    },
    "author": {
      "default": "Erik Lindqvist",
      "type": "string"
    },
    "heroImage": {
      "default": "/images/hero-bg.webp",
      "type": "string"
    },
    "imageAlt": {
      "default": "IPTV Sverige Guide",
      "type": "string"
    },
    "tags": {
      "default": [
        "IPTV Sverige",
        "Svensk IPTV",
        "Streaming"
      ],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "readingTime": {
      "default": "6 min",
      "type": "string"
    },
    "category": {
      "default": "Guider",
      "type": "string"
    },
    "targetKeyword": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "pubDate"
  ]
}